{
  "name": "deepseek-react",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @deepseek-react/web --filter @deepseek-react/server dev",
    "dev:web": "pnpm --filter @deepseek-react/web dev",
    "dev:server": "pnpm --filter @deepseek-react/server dev",
    "server:dev": "pnpm dev:server",
    "db:migrate": "pnpm --filter @deepseek-react/server db:migrate",
    "build": "pnpm --filter @deepseek-react/web build",
    "lint": "pnpm --filter @deepseek-react/web lint",
    "preview": "pnpm --filter @deepseek-react/web preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "volta": {
    "node": "24.14.1"
  }
}
